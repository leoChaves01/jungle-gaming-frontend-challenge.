{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|art/|fonts/|robots.txt|mockServiceWorker.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
